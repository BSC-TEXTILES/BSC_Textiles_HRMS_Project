# ── Database (MySQL 8.0) ────────────────────────────────────────────────────
# start-mysql.ps1 boots MySQL with `--initialize-insecure`, so root has NO
# password locally. If you secured root yourself, add it here:
#   mysql://root:YOUR_PASSWORD@localhost:3306/bsc_textiles_hrms
DATABASE_URL="mysql://root@localhost:3306/bsc_textiles_hrms"

# ── JWT ─────────────────────────────────────────────────────────────────────
# Generate a strong secret for production:  openssl rand -base64 48
# (Development falls back to a stable built-in key when this is left as-is.)
JWT_SECRET="bsc-textiles-hrms-super-secret-jwt-key-2024-production-ready-32chars"
JWT_EXPIRES_IN="12h"

# ── App / backend ───────────────────────────────────────────────────────────
NODE_ENV="development"
PORT=4000
FRONTEND_URL="http://localhost:3000"

# ── Frontend ────────────────────────────────────────────────────────────────
# Used by the browser (axios) and by NextAuth's server-side authorize().
NEXT_PUBLIC_API_URL="http://localhost:4000/api"
API_URL="http://localhost:4000/api"
NEXTAUTH_SECRET="bsc-textiles-hrms-super-secret-jwt-key-2024-production-ready-32chars"
NEXTAUTH_URL="http://localhost:3000"

# ── File upload ─────────────────────────────────────────────────────────────
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=10485760

# ── Email & SMTP (Payroll Payslip Auto-Send) ──────────────────────────────────
# Configure SMTP server credentials for auto-dispatching payslips with PDF attachments.
# In local development, leaving SMTP unconfigured safely falls back to simulated email dispatch with full delivery tracking.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER="payroll@bsctextiles.com"
SMTP_PASS="your-app-specific-password"
SMTP_FROM="BSC Textiles Payroll <payroll@bsctextiles.com>"
