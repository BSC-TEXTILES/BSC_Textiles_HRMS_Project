# =============================================================================
# BSC Textiles HRMS — environment template
#
#   cp .env.example .env        (never commit .env; it is git-ignored)
#
# Everything the security layer reads is here, under the names the code
# actually uses. Values marked [REQUIRED IN PROD] make the backend refuse to
# boot in production when missing — that is deliberate: the previous build
# carried a hard-coded JWT secret as a fallback, which is how a committed
# constant became a production credential.
#
# Secrets can also arrive as files instead of variables. Set SECRETS_DIR and
# drop <name-in-lowercase> in that directory (Docker/Kubernetes secret mount
# convention); readSecretValue() checks the environment first, then the file.
# That is the vault seam — swap the mount for a vault agent, no code change.
# =============================================================================

# ── Runtime ─────────────────────────────────────────────────────────────────
NODE_ENV="development"
PORT=4000
FRONTEND_URL="http://localhost:3000"
BIOMETRIC_LOG_LEVEL="info"
# Extra SQL tracing in the SQLite engine. Never enable in production: query
# text containing personal data ends up in the logs.
DEBUG_SQL="false"

# Where secrets-as-files live, e.g. /run/secrets (Kubernetes) or
# /run/secrets/bsc-hrms (Docker swarm). Empty means environment variables only.
SECRETS_DIR=""

# ── Database & Multi-Tenant Sharding (MySQL 8.0) ────────────────────────────
# Central Metadata / Control Database (BSC-SHARD-HQ-001): users, authentication,
# global registry, audit logs.
DATABASE_URL="mysql://root@localhost:3306/bsc_textiles_hrms"
DATABASE_URL_HQ="mysql://root@localhost:3306/bsc_textiles_hrms"

# Location-Based Operational Showroom Shards
DATABASE_URL_BEL="mysql://root@localhost:3306/bsc_shard_bel"
DATABASE_URL_DAV="mysql://root@localhost:3306/bsc_shard_dav"
DATABASE_URL_SHI="mysql://root@localhost:3306/bsc_shard_shi"

# Database engine: "mysql" (server/dev, default) or "sqlite" (offline desktop).
DB_TYPE="mysql"

# PostgreSQL / Supabase engine (DB_TYPE=postgres, or a postgresql:// URL).
# There is no built-in default connection string any more: one used to be
# hardcoded in three files, with a live password, in a public repository.
SUPABASE_POOLER_URL=""
SUPABASE_DB_URL=""
# Certificate verification is ON by default. Setting this to false turns TLS
# into encryption anyone can intercept — only for a database you control on a
# network you control.
PGSSL_REJECT_UNAUTHORIZED="true"
PGSSL_CA_FILE=""

# MySQL account for the application. In compose this is a least-privilege user
# with no DDL rights — migrations run as a separate, short-lived credential, so
# an SQL injection cannot ALTER or DROP anything.
MYSQL_DATABASE="bsc_textiles_hrms"
MYSQL_USER="bsc_hrms_app"
MYSQL_PASSWORD=""            # [REQUIRED IN PROD]
MYSQL_ROOT_PASSWORD=""       # [REQUIRED IN PROD] — not used by the app at all

# Shard pool sizing is not environment driven — it is set in
# backend/src/core/sharding/ShardConnectionManager.ts.

# Offline desktop fallback engine (DB_TYPE=sqlite).
SQLITE_PATH=""

# ── Shared store (Redis) ────────────────────────────────────────────────────
# Holds sessions, login-attempt counters, cooldown keys, rate-limit windows,
# the JWT revocation list and the role-permission cache.
#
# Empty is NOT a safe production value: without Redis those counters live in a
# single process's memory, so they reset on every restart and vanish on a
# second API replica. Set REDIS_REQUIRED=true in production and let the backend
# refuse to start rather than run with lockouts that do not exist.
REDIS_URL="redis://localhost:6379/0"
# Use rediss:// plus TLS once the certificates in infra/redis/tls exist.
REDIS_TLS="false"
REDIS_REQUIRED="false"       # production compose overrides this to true
REDIS_KEY_PREFIX="bsc:"
# Password passed to redis-server via --requirepass (redis.conf cannot expand
# variables, so there is no requirepass line in it). Must appear in the
# REDIS_URL userinfo too: redis://:<this>@cache:6379/0
REDIS_PASSWORD=""            # [REQUIRED IN PROD]
REDIS_TLS_DIR="./infra/redis/tls"

# ── Login protection ────────────────────────────────────────────────────────
# Consecutive wrong passwords before the account cools down. The spec is 4.
MAX_ATTEMPTS=4
# Cooldown length in seconds. A cooldown rejects every attempt, INCLUDING the
# correct password — otherwise it is a rate hint for an attacker.
LOCKOUT_SECONDS=180
# A CAPTCHA is required from this many consecutive failures onward (spec: 2).
CAPTCHA_AFTER_ATTEMPTS=2
# Admin/Super Admin is notified once an account hits this many lockouts.
ALERT_AFTER_LOCKOUTS=2
# 0 disables permanent escalation; set N to freeze the account until an Admin
# unlocks it after N cooldowns.
ESCALATE_AFTER_LOCKOUTS=0

# Whether a cooldown also blocks the whole source IP. Default false: every
# showroom signs in through one NAT address, so four typos by one clerk would lock
# out the entire store. Per-IP attempts are still counted (dashboard, brute-force
# alert, auto-block) and auth stays rate limited per IP + login ID, so this only
# removes the shared-line outage.
LOCKOUT_PER_IP="false"
# Two successful sign-ins for the same account from different /24 (IPv4) or
# /64 (IPv6) networks inside this many minutes raise an IMPOSSIBLE_TRAVEL alert.
# It is a network-velocity check, not a GeoIP distance check — see SECURITY.md.
# 0 disables it.
IMPOSSIBLE_TRAVEL_WINDOW_MINUTES=15
# Every login response is held at least this long, so a locked account or an
# unknown login ID cannot be told apart from a real verification by timing.
# Set it above your slowest expected Argon2id verify; 0 disables.
LOGIN_MIN_RESPONSE_MS=350
# Both must stay false in production. Self-registration and an anonymous
# "forgot password" endpoint are the two ways back into a credential store that
# this deployment deliberately closed: only an Admin creates or resets logins.
ALLOW_SELF_REGISTRATION="false"
ALLOW_PUBLIC_PASSWORD_RESET="false"

# ── Rate limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED="true"
# Global per-IP sliding window. Spec: 100 requests/second.
RATE_LIMIT_PER_SECOND=100
# Credential endpoints get their own, much tighter budget, keyed on
# IP + login ID so one account cannot be sprayed from a botnet.
RATE_LIMIT_SENSITIVE=5
RATE_LIMIT_SENSITIVE_WINDOW=60
# A source IP that trips the limiter this many times is added to ip_rules as a
# temporary deny, which also alerts an Admin.
RATE_LIMIT_AUTOBLOCK_TRIPS=5
RATE_LIMIT_AUTOBLOCK_SECONDS=900

# ── Tokens: signing, rotation, revocation ───────────────────────────────────
# ES256 (ECDSA P-256) by default; RS256/ES256 are accepted. Keys are generated
# and stored in the signing_keys table, sealed with TOKEN_KEY_ENCRYPTION_KEY,
# published through /.well-known/jwks.json and rotated by kid.
JWT_ALGORITHM="ES256"
JWT_ISSUER="bsc-textiles-hrms"
JWT_AUDIENCE="bsc-textiles-hrms-web"
# Short-lived access token, long-lived rotating refresh token.
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="7d"
# Every refresh rotates the token and invalidates the old one. Presenting a
# previously-rotated token revokes the whole family and forces re-login.
JWT_KEY_ROTATION_DAYS=90
# A retired key keeps verifying for this long so in-flight tokens do not error.
JWT_KEY_GRACE="24h"
# [REQUIRED IN PROD] AES-256-GCM key sealing the private signing keys at rest:
#   openssl rand -hex 32
# Also readable as ${SECRETS_DIR}/token_key_encryption_key.
TOKEN_KEY_ENCRYPTION_KEY=""
# Legacy HMAC secret, kept only for endpoints still verifying old JWTs. Rotate
# it independently of HIRING_ENCRYPTION_KEY once nothing derives from it.
JWT_SECRET=""
JWT_EXPIRES_IN="12h"

# ── Sessions and cookies ────────────────────────────────────────────────────
# Idle timeout: no request for this long signs the session out. The UI warns
# SESSION_WARNING_SECONDS before it expires with a "Stay signed in" button.
IDLE_TIMEOUT="15m"
# Absolute cap regardless of activity.
ABSOLUTE_TIMEOUT="8h"
SESSION_WARNING_SECONDS=60
SINGLE_ACTIVE_SESSION="false"
MAX_CONCURRENT_SESSIONS=3

# ── Password policy ─────────────────────────────────────────────────────────
PASSWORD_MIN_LENGTH=12
PASSWORD_HISTORY_COUNT=5          # block reuse of the last N passwords
PASSWORD_EXPIRY_DAYS=90           # 0 disables expiry
PASSWORD_CHECK_BREACHED="true"    # reject common / known-breached passwords
PASSWORD_BLOCK_USERNAME="true"    # reject passwords containing login ID/name
PASSWORD_BLOCK_USERNAME="true"    # reject passwords containing login ID/name
# [REQUIRED IN PROD] mixed into every hash before Argon2id, so a database dump
# alone cannot be cracked:   openssl rand -base64 48
# Losing it does not expose passwords; regenerating it invalidates every
# existing one. Back it up with the vault.
PASSWORD_PEPPER=""

# ── MFA ─────────────────────────────────────────────────────────────────────
# When true, Admin and Super Admin accounts must complete TOTP to sign in.
MFA_REQUIRED_FOR_PRIVILEGED="false"
TOTP_ISSUER="BSC Textiles HRMS"

# ── Transport, headers, CORS ────────────────────────────────────────────────
# Number of trusted proxy hops in front of the API. Behind one Nginx this is 1.
# Higher than reality lets a client append its own X-Forwarded-For entry and
# choose which IP gets rate limited; 0 means every client looks like the proxy.
TRUST_PROXY_HOPS=1
REQUIRE_HTTPS="true"
# COOKIE_SECURE=true also switches on the `__Host-` cookie prefix, which pins
# the session cookie to this exact origin. The prefix requires HTTPS, so it is
# off in local development by necessity, not by choice.
COOKIE_SECURE="false"
COOKIE_SAME_SITE="strict"
# Must be an exact host. A leading dot (wildcard) is rejected at boot.
COOKIE_DOMAIN=""
HSTS_HEADER="max-age=63072000; includeSubDomains; preload"
# CSP without 'unsafe-inline' scripts where the framework allows it.
STRICT_CSP="false"
# Exact origins only, comma separated. Never "*" and never a wildcard subdomain
# together with credentials: true.
CORS_ALLOWLIST="http://localhost:3000"
# Nginx TLS material directory mounted read-only into the proxy container.
TLS_DIR="./infra/nginx/tls"

# ── Security alerts ─────────────────────────────────────────────────────────
# Repeated lockouts, credential resets, brute-force patterns, token reuse and
# auto-blocked IPs go here.
SECURITY_ALERT_EMAIL=""
HR_ADMIN_EMAIL=""
ADMIN_EMAIL=""
SECURITY_ALERTS_EMAIL="true"
SECURITY_WEBHOOK_URL=""
SECURITY_ALERTS_WEBHOOK="false"

# ── Privacy, consent and retention ──────────────────────────────────────────
# Bumping this makes every user re-consent on their next visit.
CONSENT_POLICY_VERSION="2026-10"
# The scheduler purges rows older than these; 0 disables that table's purge.
RETENTION_AUDIT_LOG_DAYS=730
RETENTION_LOGIN_ATTEMPT_DAYS=180
RETENTION_SESSION_DAYS=90
RETENTION_REVOKED_TOKEN_DAYS=30
RETENTION_REFRESH_TOKEN_DAYS=30
RETENTION_PURGE_INTERVAL_HOURS=24

# ── File uploads ────────────────────────────────────────────────────────────
# Absolute or relative to the process working directory. Size limits and the
# quarantine path are NOT environment driven: the 10 MB cap is a constant in
# backend/src/core/services/security/FileSecurityService.ts and quarantine is
# resolved as <cwd>/storage/quarantine — which is why the container's WORKDIR
# is part of the storage contract. Scan before it is served: there is no
# ClamAV socket configured here because no code reads one.
UPLOAD_DIR="./uploads"

# ── Email / SMTP ────────────────────────────────────────────────────────────
SMTP_HOST="smtp.sendgrid.net"
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER="apikey"
SMTP_PASS=""
SMTP_FROM="BSC Textiles HRMS <noreply@bsctextiles.com>"

# ── Frontend (Next.js) ──────────────────────────────────────────────────────
# Keep this first-party in production. The session cookies are HttpOnly; a
# cross-origin API_URL would mean sending them to another host and needing CORS
# with credentials.
NEXT_PUBLIC_API_URL="/api"
API_URL="http://localhost:4000/api"
BACKEND_URL="http://localhost:4000"
# Empty derives the socket URL from NEXT_PUBLIC_API_URL's origin, which is what
# you want when Nginx proxies /socket.io/ to the API on the same host.
NEXT_PUBLIC_WS_URL="http://localhost:4000"
NEXTAUTH_URL="http://localhost:3000"
# [REQUIRED IN PROD]   openssl rand -base64 32
# A committed fallback would let anyone with the repository mint a session.
NEXTAUTH_SECRET=""

# ── Hiring module ───────────────────────────────────────────────────────────
# [REQUIRED IN PROD] derives the AES-256-GCM keys that seal candidate PII:
#   openssl rand -base64 32
# Rows encrypted before this variable existed were sealed with a key derived
# from JWT_SECRET, which is still accepted as a fallback — setting a new value
# here does not invalidate existing candidate data.
HIRING_ENCRYPTION_KEY=""
HIRING_PUBLIC_SUBMIT_MAX=5
HIRING_AUTO_PROVISION="false"
HIRING_OUTBOX_INTERVAL_MS=5000
HIRING_OUTBOX_DISABLED="false"
HIRING_SHARD_SCHEMA_PATH=""

# ===========================================================================
# Hardware Biometric IoT Terminals (eSSL MB160 & ZKTeco Dual-Mode Architecture)
# ===========================================================================
# Dual-Mode Synchronization Architecture:
# - "cloud_push": For Hostinger / cloud production server. Terminals push directly via
#                 ADMS HTTP/HTTPS to /iclock. Worker monitors heartbeats, timeouts,
#                 and mismatch sweeps; skips unroutable private RFC 1918 LAN IPs.
# - "local_lan":  For local testing or authorized in-store network computer.
#                 Worker actively polls terminals via native ZK protocol on port 4370.
# - "hybrid":     Enables both local LAN polling and ADMS cloud push simultaneously.
DEVICE_SYNC_MODE="cloud_push"

BIOMETRIC_TERMINAL_PORT=4370
BIOMETRIC_DEFAULT_TIMEZONE="Asia/Kolkata"
BIOMETRIC_POLL_INTERVAL_MS=2500
BIOMETRIC_HEARTBEAT_TIMEOUT_SECONDS=15
# Shared secret for the showroom edge connector (x-connector-key header).
BIOMETRIC_CONNECTOR_KEY=""       # [REQUIRED IN PROD]
BIOMETRIC_LOG_DIR="./logs"
BIOMETRIC_LOG_LEVEL="info"
WORKER_AUTORESTART="true"

# Demo/fixture seeding at API boot. Several scripts/setup* modules insert
# development data — invented former employees and F&F records, sample late fines
# and attendance, break sessions, retail sales, custody assets, document dossier
# fixtures, and the loopback simulator terminal (SIMMB160DEMO01).
#   unset      -> enabled outside production, disabled in production (recommended)
#   false      -> never seed fixtures, even in development
#   true       -> seed; in production this is a deliberate, loudly-logged choice
# Schema/reference shaping (tables, views, document-type catalogue, store
# topology, salary cadres) always runs regardless of this setting.
HRMS_BOOT_FIXTURES=""
