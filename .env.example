# ── Database (MySQL 8.0) ────────────────────────────────────────────────────
# start-mysql.ps1 boots MySQL with `--initialize-insecure`, so root has NO
# password locally. If you secured root yourself, add it here:
#   mysql://root:YOUR_PASSWORD@localhost:3306/bsc_textiles_hrms
DATABASE_URL="mysql://root@localhost:3306/bsc_textiles_hrms"

# ── JWT / Authentication ─────────────────────────────────────────────────────
# Generate strong RSA keys for production:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
# Store private key in JWT_PRIVATE_KEY (PKCS#8 PEM format, single line with \n)
# Store public key in JWT_PUBLIC_KEY (SPKI PEM format, single line with \n)
JWT_PRIVATE_KEY=""
JWT_PUBLIC_KEY=""
JWT_ISSUER="bsc-textiles-hrms"
JWT_AUDIENCE="bsc-textiles-hrms-api"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="30d"

# Legacy fallback (HMAC secret, minimum 32 characters)
JWT_SECRET="generate-with-openssl-rand-hex-32-min-32-chars"
JWT_EXPIRES_IN="12h"

# ── MFA Configuration ────────────────────────────────────────────────────────
MFA_ISSUER="BSC Textiles HRMS"
WEB_AUTHN_RP_ID="localhost"
WEB_AUTHN_ORIGIN="http://localhost:3000"

# ── Password Security ────────────────────────────────────────────────────────
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SYMBOLS=true
PASSWORD_MAX_LENGTH=128
PASSWORD_CHECK_BREACHES=true
PASSWORD_HISTORY_LIMIT=12
PASSWORD_ROTATION_DAYS_PRIVILEGED=90
PASSWORD_ROTATION_DAYS_STANDARD=180

# ── Account Lockout ──────────────────────────────────────────────────────────
LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
LOCKOUT_ESCALATION_ATTEMPTS=10
LOCKOUT_ESCALATION_DURATION_HOURS=1
LOCKOUT_ADMIN_UNLOCK_ATTEMPTS=20

# ── Session Management ───────────────────────────────────────────────────────
SESSION_TTL_DAYS=30
ACCESS_TOKEN_TTL_MINUTES=15
MAX_CONCURRENT_SESSIONS=3
IDLE_TIMEOUT_MINUTES=30
ABSOLUTE_TIMEOUT_HOURS=12

# ── Rate Limiting ────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379/0"
RATE_LIMIT_AUTH_CRITICAL="5/1m"
RATE_LIMIT_AUTH_SENSITIVE="3/1h"
RATE_LIMIT_UPLOAD="10/1m"
RATE_LIMIT_EXPORT="5/1m"
RATE_LIMIT_API="100/1m"

# ── Email & SMTP ─────────────────────────────────────────────────────────────
# Configure SMTP server credentials for transactional emails.
# Use a dedicated transactional email provider (SendGrid, AWS SES, Mailgun, etc.)
SMTP_HOST="smtp.sendgrid.net"
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER="apikey"
SMTP_PASS="your-sendgrid-api-key"
SMTP_FROM="BSC Textiles HRMS <noreply@bsctextiles.com>"

# Email verification and password reset token TTL
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=15
EMAIL_VERIFICATION_SECRET="generate-with-openssl-rand-base64-32"

# ── File Upload Security ─────────────────────────────────────────────────────
UPLOAD_DIR="./uploads"
QUARANTINE_DIR="./quarantine"
MAX_FILE_SIZE_FACE=5242880
MAX_FILE_SIZE_DOCUMENT=20971520
MAX_FILE_SIZE_IMPORT=5242880
CLAMAV_SOCKET="/var/run/clamav/clamd.sock"
CLAMAV_TIMEOUT_MS=30000

# ── Security Monitoring ──────────────────────────────────────────────────────
SENTRY_DSN=""
LOG_LEVEL="info"
AUDIT_LOG_LEVEL="warn"
SECURITY_ALERT_WEBHOOK=""

# ── App / backend ────────────────────────────────────────────────────────────
NODE_ENV="development"
PORT=4000
FRONTEND_URL="http://localhost:3000"
TRUSTED_PROXIES="127.0.0.1,::1"

# ── Frontend ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:4000/api"
API_URL="http://localhost:4000/api"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# ── CSP / Security Headers ───────────────────────────────────────────────────
CSP_NONCE_ENABLED="true"
CSP_REPORT_ONLY="false"
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=true