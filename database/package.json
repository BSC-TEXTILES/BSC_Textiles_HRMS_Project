{
  "name": "bsc-textiles-hrms-database",
  "version": "1.0.0",
  "description": "BSC Textiles HRMS — Pure Native MySQL 8.0 Architecture (Zero Prisma)",
  "main": "src/pool.ts",
  "type": "module",
  "scripts": {
    "build": "echo 'Database workspace uses native SQL - no build step required'",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:setup": "tsx scripts/migrate.ts && tsx scripts/seed.ts",
    "db:schema": "tsx scripts/schema.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.3.1",
    "mysql2": "^3.24.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.10.6",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
