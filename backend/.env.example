# Database (PostgreSQL / Supabase or MySQL)
DATABASE_URL="mysql://root@localhost:3306/bsc_textiles_hrms"
# For Supabase Cloud PostgreSQL:
# SUPABASE_POOLER_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres"
# SUPABASE_DB_URL="postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres"

# Database engine: "mysql" (server/dev, default), "postgres" (Supabase Cloud), or "sqlite" (offline desktop)
DB_TYPE="mysql"

# JWT — Generate with: openssl rand -base64 48 (min 32 chars)
JWT_SECRET="your-strong-random-jwt-secret-minimum-32-characters"
JWT_EXPIRES_IN="12h"

# Hardware Biometric Connector Key
BIOMETRIC_CONNECTOR_KEY="your-biometric-connector-secret-key"

# Server
NODE_ENV="development"
PORT=4000
FRONTEND_URL="http://localhost:3000"

# File upload
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=10485760

# Email & SMTP (Payroll Payslip Auto-Send)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER="payroll@bsctextiles.com"
SMTP_PASS="your-app-specific-password"
SMTP_FROM="BSC Textiles Payroll <payroll@bsctextiles.com>"

# ===========================================================================
# Hardware Biometric IoT Terminals (eSSL & ZKTeco Standalone Attendance Clocks)
# Protocol: TCP/IP Port 4370 (ZKTeco standalone SDK / Push)
# Authoritative storage: Cloud MySQL (bsc_textiles_hrms)
# ===========================================================================
BIOMETRIC_TERMINAL_PORT=4370

# Device 1: Belagavi Flagship (Karnataka HQ · Ground Floor)
BIOMETRIC_DEV1_NAME="ZKTeco / eSSL Belagavi Flagship Main Terminal"
BIOMETRIC_DEV1_SERIAL="JNP2252300795"
BIOMETRIC_DEV1_IP="192.168.100.135"
BIOMETRIC_DEV1_LOCATION="DAV"

# Device 2: Davanagere Mega Store (KB Extension · Floor 1)
BIOMETRIC_DEV2_NAME="ZKTeco / eSSL Davanagere Mega Store Terminal"
BIOMETRIC_DEV2_SERIAL="JNPJNP2252300802"
BIOMETRIC_DEV2_IP="192.168.100.136"
BIOMETRIC_DEV2_LOCATION="DAV"

# Device 3: Shivamogga Flagship (B.H. Road Apex · Floor 1)
BIOMETRIC_DEV3_NAME="ZKTeco / eSSL Shivamogga Flagship Terminal"
BIOMETRIC_DEV3_SERIAL="JNP2252300797"
BIOMETRIC_DEV3_IP="192.168.100.137"
BIOMETRIC_DEV3_LOCATION="DAV"
