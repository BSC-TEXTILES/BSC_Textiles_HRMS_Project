# =============================================================================
# BSC Textiles HRMS — Backend Environment Template (.env.example)
# =============================================================================

# ── Runtime ─────────────────────────────────────────────────────────────────
NODE_ENV="production"
PORT=4000
FRONTEND_URL="https://hrms.bsctextiles.in"
BACKEND_URL="http://127.0.0.1:4000"
API_URL="http://127.0.0.1:4000/api"
NEXT_PUBLIC_API_URL="/api"
BIOMETRIC_LOG_LEVEL="info"
DEBUG_SQL="false"
SECRETS_DIR=""

# ── Database & Multi-Tenant Sharding (MySQL 8.0) ────────────────────────────
DATABASE_URL="mysql://username:password@127.0.0.1:3306/u101820759_bsc_smg_HRMS"
DATABASE_URL_HQ="mysql://username:password@127.0.0.1:3306/u101820759_bsc_smg_HRMS"

DATABASE_URL_BEL="mysql://username:password@127.0.0.1:3306/u101820759_bsc_smg_HRMS"
DATABASE_URL_DAV="mysql://username:password@127.0.0.1:3306/u101820759_bsc_smg_HRMS"
DATABASE_URL_SHI="mysql://username:password@127.0.0.1:3306/u101820759_bsc_smg_HRMS"

DB_TYPE="mysql"
DB_HOST="127.0.0.1"
DB_PORT="3306"
DB_USER="u101820759_bsc_smg_HRMS"
DB_PASSWORD="your-database-password"
DB_NAME="u101820759_bsc_smg_HRMS"

MYSQL_DATABASE="u101820759_bsc_smg_HRMS"
MYSQL_USER="u101820759_bsc_smg_HRMS"
MYSQL_PASSWORD="your-database-password"
MYSQL_ROOT_PASSWORD=""
SQLITE_PATH=""

# ── Shared store (Redis) ────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379/0"
REDIS_TLS="false"
REDIS_REQUIRED="false"
REDIS_KEY_PREFIX="bsc:"
REDIS_PASSWORD=""
REDIS_TLS_DIR="./infra/redis/tls"

# ── Login protection ────────────────────────────────────────────────────────
MAX_ATTEMPTS=4
LOCKOUT_SECONDS=180
CAPTCHA_AFTER_ATTEMPTS=2
ALERT_AFTER_LOCKOUTS=2
ESCALATE_AFTER_LOCKOUTS=0
LOCKOUT_PER_IP="false"
IMPOSSIBLE_TRAVEL_WINDOW_MINUTES=15
LOGIN_MIN_RESPONSE_MS=350
ALLOW_SELF_REGISTRATION="false"
ALLOW_PUBLIC_PASSWORD_RESET="false"

# ── Rate limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED="true"
RATE_LIMIT_PER_SECOND=100
RATE_LIMIT_SENSITIVE=5
RATE_LIMIT_SENSITIVE_WINDOW=60
RATE_LIMIT_AUTOBLOCK_TRIPS=5
RATE_LIMIT_AUTOBLOCK_SECONDS=900

# ── Tokens: signing, rotation, revocation ───────────────────────────────────
JWT_ALGORITHM="ES256"
JWT_ISSUER="bsc-textiles-hrms"
JWT_AUDIENCE="bsc-textiles-hrms-web"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="7d"
JWT_KEY_ROTATION_DAYS=90
JWT_KEY_GRACE="24h"
TOKEN_KEY_ENCRYPTION_KEY="your-encryption-key-min-32-chars"
JWT_SECRET="your-strong-random-jwt-secret-key-min-32-chars"
JWT_EXPIRES_IN="12h"

# ── Sessions and cookies ────────────────────────────────────────────────────
IDLE_TIMEOUT="15m"
ABSOLUTE_TIMEOUT="8h"
SESSION_WARNING_SECONDS=60
SINGLE_ACTIVE_SESSION="false"
MAX_CONCURRENT_SESSIONS=3

# ── Password policy ─────────────────────────────────────────────────────────
PASSWORD_MIN_LENGTH=12
PASSWORD_HISTORY_COUNT=5
PASSWORD_EXPIRY_DAYS=90
PASSWORD_CHECK_BREACHED="true"
PASSWORD_BLOCK_USERNAME="true"
PASSWORD_PEPPER="your-password-pepper-string"

# ── MFA ─────────────────────────────────────────────────────────────────────
MFA_REQUIRED_FOR_PRIVILEGED="false"
TOTP_ISSUER="BSC Textiles HRMS"

# ── Transport, headers, CORS ────────────────────────────────────────────────
TRUST_PROXY_HOPS=1
REQUIRE_HTTPS="false"
COOKIE_SECURE="false"
COOKIE_SAME_SITE="lax"
COOKIE_DOMAIN=""
HSTS_HEADER="max-age=63072000; includeSubDomains; preload"
STRICT_CSP="false"
CORS_ALLOWLIST="https://hrms.bsctextiles.in,http://localhost:3000,http://127.0.0.1:3000,http://localhost:4000,http://127.0.0.1:4000"
TLS_DIR="./infra/nginx/tls"

# ── Security alerts ─────────────────────────────────────────────────────────
SECURITY_ALERT_EMAIL=""
HR_ADMIN_EMAIL=""
ADMIN_EMAIL=""
SECURITY_ALERTS_EMAIL="false"
SECURITY_WEBHOOK_URL=""
SECURITY_ALERTS_WEBHOOK="false"

# ── Privacy, consent and retention ──────────────────────────────────────────
CONSENT_POLICY_VERSION="2026-10"
RETENTION_AUDIT_LOG_DAYS=730
RETENTION_LOGIN_ATTEMPT_DAYS=180
RETENTION_SESSION_DAYS=90
RETENTION_REVOKED_TOKEN_DAYS=30
RETENTION_REFRESH_TOKEN_DAYS=30
RETENTION_PURGE_INTERVAL_HOURS=24

# ── File uploads ────────────────────────────────────────────────────────────
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=10485760

# ── Email / SMTP ────────────────────────────────────────────────────────────
SMTP_HOST="smtp.sendgrid.net"
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER="apikey"
SMTP_PASS=""
SMTP_FROM="BSC Textiles HRMS <noreply@bsctextiles.com>"

# ── Hiring module ───────────────────────────────────────────────────────────
HIRING_ENCRYPTION_KEY="your-hiring-encryption-key"
HIRING_PUBLIC_SUBMIT_MAX=5
HIRING_AUTO_PROVISION="false"
HIRING_OUTBOX_INTERVAL_MS=5000
HIRING_OUTBOX_DISABLED="false"
HIRING_SHARD_SCHEMA_PATH=""

# ===========================================================================
# Hardware Biometric IoT Terminals (Davangere Location Exclusively)
# ===========================================================================
BIOMETRIC_TERMINAL_PORT=4370
DEVICE_SYNC_MODE="disabled"
DISABLE_DEVICE_POLLING="1"
BIOMETRIC_DEFAULT_TIMEZONE="Asia/Kolkata"
BIOMETRIC_POLL_INTERVAL_MS=2500
BIOMETRIC_HEARTBEAT_TIMEOUT_SECONDS=15
BIOMETRIC_CONNECTOR_KEY="your-biometric-edge-connector-key"
BIOMETRIC_LOG_DIR="./logs"
BIOMETRIC_LOG_LEVEL="info"
WORKER_AUTORESTART="true"
HRMS_BOOT_FIXTURES=""

# Device 1: Davangere Store (Main Entrance)
BIOMETRIC_DEV1_NAME="eSSL Davangere Terminal 1 (Main Entrance)"
BIOMETRIC_DEV1_SERIAL="JNP2252300795"
BIOMETRIC_DEV1_IP="192.168.100.137"
BIOMETRIC_DEV1_LOCATION="DAV"

# Device 2: Davangere Store (Staff Lounge)
BIOMETRIC_DEV2_NAME="eSSL Davangere Terminal 2 (Staff Lounge)"
BIOMETRIC_DEV2_SERIAL="JNP2252300802"
BIOMETRIC_DEV2_IP="192.168.100.135"
BIOMETRIC_DEV2_LOCATION="DAV"

# Device 3: Davangere Store (Admin / Billing Floor)
BIOMETRIC_DEV3_NAME="eSSL Davangere Terminal 3 (Admin / Billing)"
BIOMETRIC_DEV3_SERIAL="JNP2252300797"
BIOMETRIC_DEV3_IP="192.168.100.136"
BIOMETRIC_DEV3_LOCATION="DAV"
