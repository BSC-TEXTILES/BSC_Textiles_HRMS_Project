# Database (root has no password with start-mysql.ps1's insecure init;
# add `:YOUR_PASSWORD` after `root` if you secured it yourself)
DATABASE_URL="mysql://root@localhost:3306/bsc_textiles_hrms"

# JWT — must be identical to the root/.env value or every login 401s.
JWT_SECRET="bsc-textiles-hrms-super-secret-jwt-key-2024-production-ready-32chars"
JWT_EXPIRES_IN="12h"

# Server
NODE_ENV="development"
PORT=4000
FRONTEND_URL="http://localhost:3000"

# File upload
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=10485760

# Email & SMTP (Payroll Payslip Auto-Send)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER="payroll@bsctextiles.com"
SMTP_PASS="your-app-specific-password"
SMTP_FROM="BSC Textiles Payroll <payroll@bsctextiles.com>"
