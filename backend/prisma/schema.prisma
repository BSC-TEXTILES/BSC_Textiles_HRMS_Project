generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/.prisma/client"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  HR_MANAGER
  HR_EXECUTIVE
  PAYROLL_MANAGER
  LOCATION_MANAGER
  FLOOR_MANAGER
  DEPARTMENT_MANAGER
  TEAM_LEAD
  SALES_EMPLOYEE
  TEA_BREAK_MANAGER
  T_SHOP_OWNER
  HR_AUDITOR
  EMPLOYEE
}

enum Permission {
  VIEW
  ADD
  EDIT
  DELETE
  APPROVE
  REJECT
  ASSIGN
  EXPORT
  IMPORT
  CONFIGURE
  MANAGE
  RECORD
  UPLOAD
  PUBLISH
  SCAN
  VIEW_SENSITIVE_DATA
}

enum LocationStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum FloorStatus {
  ACTIVE
  INACTIVE
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  TERMINATED
}

enum ShiftStatus {
  ACTIVE
  INACTIVE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EARLY
  ON_LUNCH
  ON_TEA_BREAK
  ON_OTHER_BREAK
  WEEKLY_OFF
  OVERTIME
  LEFT_STORE
  FACE_VERIFIED
  FACE_VERIFICATION_FAILED
}

enum BreakType {
  LUNCH
  TEA
  OTHER
}

enum BreakStatus {
  NOT_STARTED
  ACTIVE
  COMPLETED
  EXCEEDED
  MANUALLY_ADJUSTED
}

enum IncentiveType {
  INDIVIDUAL
  DEPARTMENT
  LOCATION
  FLOOR
  SELLING_POINT
  SALES
  ATTENDANCE
  PERFORMANCE
  EARLY_LOGIN
  TARGET
  CUSTOM
}

enum CalculationType {
  FIXED_AMOUNT
  PER_HOUR
  PER_MINUTE
  PER_SECOND
  PERCENTAGE
  TARGET_BASED
  PERFORMANCE_BASED
  ATTENDANCE_BASED
  CUSTOM_RULE
}

enum IncentiveStatus {
  ACTIVE
  INACTIVE
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum WeeklyOffDay {
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  ROTATIONAL
}

enum FaceVerificationResult {
  VERIFIED
  FAILED
}

enum QRCodeType {
  EMPLOYEE
  DAILY
}

enum QRScanPurpose {
  ATTENDANCE_CHECK_IN
  ATTENDANCE_CHECK_OUT
  LUNCH_START
  LUNCH_END
  TEA_BREAK_START
  TEA_BREAK_END
  BREAK_START
  BREAK_END
  SELLING_POINT_CHECK_IN
}

enum QRScanResult {
  SUCCESS
  ALREADY_SCANNED
  EXPIRED
  UNAUTHORIZED_SCANNER
  LOCATION_MISMATCH
  INVALID_TOKEN
  EMPLOYEE_INACTIVE
  REVOKED
}

enum ObservationType {
  POSITIVE
  IMPROVEMENT
  CUSTOMER_SERVICE
  SALES
  GROOMING
  PRODUCT_KNOWLEDGE
  ATTENDANCE
  DISCIPLINE
  SELLING_SKILL
  STORE_STANDARD
  SAFETY
}

enum ObservationLevel {
  EXCELLENT
  VERY_GOOD
  GOOD
  NEEDS_IMPROVEMENT
  CRITICAL
}

enum ObservationStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum ReactionType {
  ACKNOWLEDGED
  COMPLETED
  EXCELLENT
  REVIEWING
  ATTENTION
}

enum LiveStreamStatus {
  SCHEDULED
  LIVE
  PAUSED
  ENDED
}

enum AuditAction {
  CREATE
  READ
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  SCAN
  VERIFY
  APPROVE
  REJECT
  ASSIGN
  CONFIGURE
  EXPORT
  IMPORT
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  fullName      String
  role          UserRole  @default(EMPLOYEE)
  permissions   Json?
  locationId    String?
  location      Location? @relation("UserLocation", fields: [locationId], references: [id])
  employeeId    String?
  employee      Employee? @relation(fields: [employeeId], references: [id])
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  managedLocations     Location[] @relation("LocationManager")
  hrManagedLocations   Location[] @relation("LocationHRManager")
  qrScans              QRScanRecord[]
  observations         Observation[] @relation("ObservationCreatedBy")
  assignedObservations  Observation[] @relation("ObservationAssignedTo")
  reactions            ObservationReaction[]
  comments             ObservationComment[]
  liveStreams          LiveStream[] @relation("LiveStreamHost")
  streamViewers        LiveStreamViewer[]
  streamMessages       LiveStreamMessage[]
  streamReactions      LiveStreamReaction[]
  auditLogs            AuditLog[]
  managedFloors        Floor[] @relation("FloorFloorManager")
  assistedFloors       Floor[] @relation("FloorAssistantManager")

  departments                Department[]
  incentiveRuleApprovedBy    IncentiveRule[] @relation("IncentiveRuleApprovedBy")
  incentiveRules             IncentiveRule[] @relation("IncentiveRuleCreatedBy")
  incentiveTransactions      IncentiveTransaction[]
  observationAttachments     ObservationAttachment[]
  penaltyTransactions        PenaltyTransaction[]
  sections                   Section[]
  sellingPoints              SellingPoint[]
  streamObservations         StreamObservation[]
  streamTimestamps           StreamTimestamp[]
  @@index([email])
  @@index([role])
  @@index([locationId])
}

model Location {
  id            String    @id @default(cuid())
  code          String    @unique
  name          String
  address       String?
  city          String?
  state         String?
  pin           String?
  phone         String?
  email         String?
  whatsapp      String?
  managerId     String?
  manager       User?     @relation("LocationManager", fields: [managerId], references: [id])
  hrManagerId   String?
  hrManager     User?     @relation("LocationHRManager", fields: [hrManagerId], references: [id])
  openingTime   DateTime?
  closingTime   DateTime?
  status        LocationStatus @default(ACTIVE)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  floors        Floor[]
  departments   Department[]
  sections      Section[]
  sellingPoints SellingPoint[]
  employees     Employee[]
  shifts        Shift[]
  attendanceRules AttendanceRules[]
  breakRules    BreakRule[]
  incentiveRules IncentiveRule[]
  weeklyOffRules WeeklyOffRule[]
  holidays      Holiday[]
  qrCodes       QRCode[]
  qrScanRecords QRScanRecord[]
  faceVerifications FaceVerification[]
  auditLogs     AuditLog[]

  attendances                Attendance[]
  liveStreams                LiveStream[]
  observations               Observation[]
  penaltyRules               PenaltyRule[]
  users                      User[] @relation("UserLocation")
  videoNotes                 VideoNote[]
  @@index([code])
  @@index([status])
}

model Floor {
  id            String    @id @default(cuid())
  name          String
  floorNumber   Int
  locationId    String
  location      Location  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  floorManagerId String?
  floorManager  User?     @relation("FloorFloorManager", fields: [floorManagerId], references: [id])
  assistantManagerId String?
  assistantManager User? @relation("FloorAssistantManager", fields: [assistantManagerId], references: [id])
  departments   Department[]
  sections      Section[]
  sellingPoints SellingPoint[]
  status        FloorStatus @default(ACTIVE)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  breakRules                 BreakRule[]
  employees                  Employee[]
  incentiveRules             IncentiveRule[]
  liveStreams                LiveStream[]
  observations               Observation[]
  weeklyOffRules             WeeklyOffRule[]
  @@unique([locationId, floorNumber])
  @@index([locationId])
  @@index([floorManagerId])
}

model Department {
  id          String   @id @default(cuid())
  name        String
  code        String
  locationId  String
  location    Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  floorId     String?
  floor       Floor?   @relation(fields: [floorId], references: [id])
  managerId   String?
  manager     User?    @relation(fields: [managerId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sections    Section[]
  employees   Employee[]
  sellingPoints SellingPoint[]

  breakRules                 BreakRule[]
  holidays                   Holiday[]
  incentiveRules             IncentiveRule[]
  penaltyRules               PenaltyRule[]
  shifts                     Shift[]
  weeklyOffRules             WeeklyOffRule[]
  @@unique([locationId, code])
  @@index([locationId])
  @@index([floorId])
}

model Section {
  id           String   @id @default(cuid())
  name         String
  code         String
  locationId   String
  location     Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  floorId      String
  floor        Floor    @relation(fields: [floorId], references: [id], onDelete: Cascade)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  supervisorId String?
  supervisor   User?    @relation(fields: [supervisorId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sellingPoints SellingPoint[]
  employees     Employee[]

  liveStreams                LiveStream[]
  observations               Observation[]
  @@unique([locationId, code])
  @@index([locationId])
  @@index([floorId])
  @@index([departmentId])
}

model SellingPoint {
  id              String   @id @default(cuid())
  name            String
  code            String
  locationId      String
  location        Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  floorId         String
  floor           Floor    @relation(fields: [floorId], references: [id], onDelete: Cascade)
  sectionId       String
  section         Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  category        String?
  departmentId    String?
  department      Department? @relation(fields: [departmentId], references: [id])
  managerId       String?
  manager         User?    @relation(fields: [managerId], references: [id])
  targetAmount    Decimal? @db.Decimal(15,2)
  incentiveRuleId String?
  incentiveRule   IncentiveRule? @relation("SellingPointIncentiveRule", fields: [incentiveRuleId], references: [id])
  performanceScore Decimal? @db.Decimal(5,2)
  status          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  employees       EmployeeSellingPoint[]
  qrScanRecords   QRScanRecord[]

  incentiveRules             IncentiveRule[] @relation("IncentiveRuleSellingPoint")
  liveStreams                LiveStream[]
  observations               Observation[]
  videoNotes                 VideoNote[]
  @@unique([locationId, code])
  @@index([locationId])
  @@index([floorId])
  @@index([sectionId])
}

model EmployeeSellingPoint {
  id              String   @id @default(cuid())
  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  sellingPointId  String
  sellingPoint    SellingPoint @relation(fields: [sellingPointId], references: [id], onDelete: Cascade)
  assignedDate    DateTime @default(now())
  isPrimary       Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@unique([employeeId, sellingPointId])
  @@index([employeeId])
  @@index([sellingPointId])
}

model Employee {
  id              String        @id @default(cuid())
  employeeCode    String        @unique
  firstName       String
  lastName        String
  fullName        String
  email           String?       @unique
  phone           String?
  gender          String?
  dateOfBirth     DateTime?
  locationId      String
  location        Location      @relation(fields: [locationId], references: [id], onDelete: Cascade)
  floorId         String?
  floor           Floor?        @relation(fields: [floorId], references: [id])
  departmentId    String?
  department      Department?   @relation(fields: [departmentId], references: [id])
  sectionId       String?
  section         Section?      @relation(fields: [sectionId], references: [id])
  sellingPoints   EmployeeSellingPoint[]
  shiftId         String?
  shift           Shift?        @relation(fields: [shiftId], references: [id])
  designation     String?
  role            UserRole      @default(EMPLOYEE)
  status          EmployeeStatus @default(ACTIVE)
  joiningDate     DateTime
  exitDate        DateTime?
  faceProfileId   String?
  faceProfile     FaceProfile?  @relation("EmployeeFaceProfile", fields: [faceProfileId], references: [id])
  qrCodeId        String?
  qrCode          QRCode?       @relation("EmployeePermanentQR", fields: [qrCodeId], references: [id])
  dailyQRCodeId   String?
  dailyQRCode     QRCode?       @relation("EmployeeDailyQR", fields: [dailyQRCodeId], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  attendances     Attendance[]
  breaks          EmployeeBreak[]
  faceVerifications FaceVerification[]
  qrScanRecords   QRScanRecord[]
  incentives      EmployeeIncentive[]
  penalties       PenaltyTransaction[]
  observations    Observation[] @relation("ObservationEmployee")
  ownedQRCodes    QRCode[] @relation("QRCodeOwnedBy")

  faceProfiles               FaceProfile[] @relation("FaceProfileEmployee")
  incentiveRules             IncentiveRule[]
  incentiveTransactions      IncentiveTransaction[]
  payrollItems               PayrollItem[]
  penaltyRules               PenaltyRule[]
  users                      User[]
  videoNotes                 VideoNote[]
  weeklyOffRules             WeeklyOffRule[]
  @@index([employeeCode])
  @@index([locationId])
  @@index([floorId])
  @@index([departmentId])
  @@index([sectionId])
  @@index([status])
}

model Shift {
  id              String   @id @default(cuid())
  name            String
  code            String
  locationId      String
  location        Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  departmentId    String?
  department      Department? @relation(fields: [departmentId], references: [id])
  startTime       DateTime
  endTime         DateTime
  gracePeriod     Int      @default(5)
  lateThreshold   Int      @default(5)
  earlyLoginIncentive Boolean @default(true)
  earlyLoginRatePerSecond Decimal @default(1) @db.Decimal(10,4)
  maxDailyEarlyIncentive Decimal? @db.Decimal(15,2)
  maxMonthlyEarlyIncentive Decimal? @db.Decimal(15,2)
  latePenaltyEnabled Boolean @default(false)
  latePenaltyRatePerSecond Decimal @default(1) @db.Decimal(10,4)
  maxDailyLatePenalty Decimal? @db.Decimal(15,2)
  maxMonthlyLatePenalty Decimal? @db.Decimal(15,2)
  overtimeEnabled Boolean @default(true)
  overtimeRatePerSecond Decimal? @db.Decimal(10,4)
  earlyLogoutPenaltyEnabled Boolean @default(false)
  earlyLogoutRatePerSecond Decimal? @db.Decimal(10,4)
  lunchDurationMinutes Int @default(100)
  teaDurationMinutes Int @default(20)
  maleLunchMinutes Int @default(100)
  femaleLunchMinutes Int @default(40)
  maleTeaMinutes Int @default(20)
  femaleTeaMinutes Int @default(15)
  faceVerificationThreshold Decimal @default(85) @db.Decimal(5,2)
  qrDailyTokenEnabled Boolean @default(true)
  qrOneTimeScan Boolean @default(true)
  scannerRoles    Json?
  status          ShiftStatus @default(ACTIVE)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  employees       Employee[]
  attendances     Attendance[]

  breakRules                 BreakRule[]
  weeklyOffRules             WeeklyOffRule[]
  @@unique([locationId, code])
  @@index([locationId])
  @@index([status])
}

model AttendanceRules {
  id                          String   @id @default(cuid())
  locationId                  String   @unique
  location                    Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  loginTime                   DateTime
  logoutTime                  DateTime
  gracePeriodMinutes          Int      @default(5)
  lateThresholdMinutes        Int      @default(5)
  earlyLoginIncentiveEnabled  Boolean  @default(true)
  earlyLoginRatePerSecond     Decimal  @default(1) @db.Decimal(10,4)
  earlyLoginMaxDaily          Decimal? @db.Decimal(15,2)
  earlyLoginMaxMonthly        Decimal? @db.Decimal(15,2)
  latePenaltyEnabled          Boolean  @default(false)
  latePenaltyRatePerSecond    Decimal  @default(1) @db.Decimal(10,4)
  latePenaltyMaxDaily         Decimal? @db.Decimal(15,2)
  latePenaltyMaxMonthly       Decimal? @db.Decimal(15,2)
  overtimeIncentiveEnabled    Boolean  @default(false)
  overtimeRatePerSecond       Decimal? @db.Decimal(10,4)
  earlyLogoutPenaltyEnabled   Boolean  @default(false)
  earlyLogoutRatePerSecond    Decimal? @db.Decimal(10,4)
  lunchDurationMinutes        Int      @default(100)
  teaDurationMinutes          Int      @default(20)
  maleLunchMinutes            Int      @default(100)
  femaleLunchMinutes          Int      @default(40)
  maleTeaMinutes              Int      @default(20)
  femaleTeaMinutes            Int      @default(15)
  faceVerificationThreshold   Decimal  @default(85) @db.Decimal(5,2)
  qrDailyTokenEnabled         Boolean  @default(true)
  qrOneTimeScan               Boolean  @default(true)
  scannerRoles                Json?
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  @@index([locationId])
}

model BreakRule {
  id              String     @id @default(cuid())
  locationId      String
  location        Location   @relation(fields: [locationId], references: [id], onDelete: Cascade)
  departmentId    String?
  department      Department? @relation(fields: [departmentId], references: [id])
  floorId         String?
  floor           Floor?     @relation(fields: [floorId], references: [id])
  shiftId         String?
  shift           Shift?     @relation(fields: [shiftId], references: [id])
  employeeGroup   String?
  breakType       BreakType
  durationMinutes Int
  maxOccurrences  Int        @default(1)
  isPaid          Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([locationId])
  @@index([departmentId])
  @@index([floorId])
  @@index([shiftId])
}

model EmployeeBreak {
  id              String     @id @default(cuid())
  employeeId      String
  employee        Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  breakType       BreakType
  breakDate       DateTime   @db.Date
  startTime       DateTime?
  endTime         DateTime?
  allowedDuration Int
  actualDuration  Int?
  excessDuration  Int?
  status          BreakStatus @default(NOT_STARTED)
  qrScanId        String?
  qrScan          QRScanRecord? @relation(fields: [qrScanId], references: [id])
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([employeeId, breakDate])
  @@index([breakType])
  @@index([status])
}

model WeeklyOffRule {
  id            String       @id @default(cuid())
  locationId    String
  location      Location     @relation(fields: [locationId], references: [id], onDelete: Cascade)
  floorId       String?
  floor         Floor?       @relation(fields: [floorId], references: [id])
  departmentId  String?
  department    Department?  @relation(fields: [departmentId], references: [id])
  employeeId    String?
  employee      Employee?    @relation(fields: [employeeId], references: [id])
  shiftId       String?
  shift         Shift?       @relation(fields: [shiftId], references: [id])
  dayOfWeek     WeeklyOffDay
  isRotational  Boolean      @default(false)
  rotationPattern String?
  effectiveFrom DateTime     @db.Date
  effectiveTo   DateTime?    @db.Date
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([locationId])
  @@index([employeeId])
  @@index([floorId])
  @@index([departmentId])
  @@index([shiftId])
}

model Holiday {
  id          String   @id @default(cuid())
  name        String
  date        DateTime @db.Date
  locationId  String?
  location    Location? @relation(fields: [locationId], references: [id], onDelete: Cascade)
  departmentId String?
  department  Department? @relation(fields: [departmentId], references: [id])
  isRecurring Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
  @@index([locationId])
}

model FaceProfile {
  id            String   @id @default(cuid())
  employeeId    String   @unique
  employee      Employee @relation("FaceProfileEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  faceData      Bytes
  enrolledAt    DateTime @default(now())
  updatedAt     DateTime @updatedAt
  isActive      Boolean  @default(true)
  employees                  Employee[] @relation("EmployeeFaceProfile")
}

model FaceVerification {
  id              String                @id @default(cuid())
  employeeId      String
  employee        Employee              @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  locationId      String
  location        Location              @relation(fields: [locationId], references: [id], onDelete: Cascade)
  deviceId        String?
  verifiedAt      DateTime              @default(now())
  matchPercentage Decimal               @db.Decimal(5,2)
  threshold       Decimal               @db.Decimal(5,2)
  result          FaceVerificationResult
  purpose         String?               @default("attendance")
  createdAt       DateTime              @default(now())

  @@index([employeeId])
  @@index([locationId])
  @@index([verifiedAt])
  @@index([result])
}

model QRCode {
  id            String     @id @default(cuid())
  token         String     @unique
  type          QRCodeType
  employeeId    String
  employee      Employee   @relation("QRCodeOwnedBy", fields: [employeeId], references: [id], onDelete: Cascade)
  locationId    String
  location      Location   @relation(fields: [locationId], references: [id], onDelete: Cascade)
  validFrom     DateTime
  validTo       DateTime
  isConsumed    Boolean    @default(false)
  consumedAt    DateTime?
  consumedBy    String?
  purpose       QRScanPurpose?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  scanRecords   QRScanRecord[]
  permanentFor  Employee[] @relation("EmployeePermanentQR")
  dailyFor      Employee[] @relation("EmployeeDailyQR")

  @@index([employeeId])
  @@index([token])
  @@index([validFrom, validTo])
  @@index([isConsumed])
}

model QRScanRecord {
  id            String       @id @default(cuid())
  qrCodeId      String
  qrCode        QRCode       @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)
  employeeId    String
  employee      Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  scannerId     String
  scanner       User         @relation(fields: [scannerId], references: [id], onDelete: Cascade)
  locationId    String
  location      Location     @relation(fields: [locationId], references: [id], onDelete: Cascade)
  sellingPointId String?
  sellingPoint  SellingPoint? @relation(fields: [sellingPointId], references: [id])
  purpose       QRScanPurpose
  result        QRScanResult
  failureReason String?
  scannedAt     DateTime     @default(now())
  deviceInfo    String?
  ipAddress     String?

  employeeBreaks             EmployeeBreak[]
  @@index([employeeId, scannedAt])
  @@index([scannerId, scannedAt])
  @@index([locationId, scannedAt])
  @@index([result])
}

model IncentiveRule {
  id                  String         @id @default(cuid())
  name                String
  description         String?
  incentiveType       IncentiveType
  calculationType     CalculationType
  locationId          String?
  location            Location?      @relation(fields: [locationId], references: [id])
  departmentId        String?
  department          Department?    @relation(fields: [departmentId], references: [id])
  floorId             String?
  floor               Floor?         @relation(fields: [floorId], references: [id])
  sellingPointId      String?
  sellingPoint        SellingPoint?  @relation("IncentiveRuleSellingPoint", fields: [sellingPointId], references: [id])
  employeeId          String?
  employee            Employee?      @relation(fields: [employeeId], references: [id])
  amount              Decimal?       @db.Decimal(15,2)
  percentage          Decimal?       @db.Decimal(5,2)
  targetAmount        Decimal?       @db.Decimal(15,2)
  effectiveFrom       DateTime       @db.Date
  effectiveTo         DateTime?      @db.Date
  maxDailyAmount      Decimal?       @db.Decimal(15,2)
  maxMonthlyAmount    Decimal?       @db.Decimal(15,2)
  status              IncentiveStatus @default(ACTIVE)
  createdById         String
  createdBy           User           @relation("IncentiveRuleCreatedBy", fields: [createdById], references: [id])
  approvedById        String?
  approvedBy          User?          @relation("IncentiveRuleApprovedBy", fields: [approvedById], references: [id])
  approvedAt          DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  employeeIncentives  EmployeeIncentive[]
  incentiveTransactions IncentiveTransaction[]

  sellingPoints              SellingPoint[] @relation("SellingPointIncentiveRule")
  @@index([locationId])
  @@index([departmentId])
  @@index([floorId])
  @@index([sellingPointId])
  @@index([employeeId])
  @@index([status])
}

model EmployeeIncentive {
  id              String        @id @default(cuid())
  employeeId      String
  employee        Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  incentiveRuleId String
  incentiveRule   IncentiveRule @relation(fields: [incentiveRuleId], references: [id], onDelete: Cascade)
  effectiveFrom   DateTime      @db.Date
  effectiveTo     DateTime?     @db.Date
  status          IncentiveStatus @default(ACTIVE)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([employeeId, incentiveRuleId])
  @@index([employeeId])
  @@index([incentiveRuleId])
}

model IncentiveTransaction {
  id                  String   @id @default(cuid())
  employeeId          String
  employee            Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  incentiveRuleId     String
  incentiveRule       IncentiveRule @relation(fields: [incentiveRuleId], references: [id], onDelete: Cascade)
  transactionDate     DateTime @db.Date
  calculationBasis    String
  calculatedAmount    Decimal  @db.Decimal(15,2)
  calculationDetails  Json
  status              IncentiveStatus @default(PENDING_APPROVAL)
  approvedById        String?
  approvedBy          User?    @relation(fields: [approvedById], references: [id])
  approvedAt          DateTime?
  payrollRunId        String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([employeeId, transactionDate])
  @@index([incentiveRuleId])
  @@index([status])
}

model PenaltyRule {
  id              String   @id @default(cuid())
  name            String
  description     String?
  locationId      String?
  location        Location? @relation(fields: [locationId], references: [id])
  departmentId    String?
  department      Department? @relation(fields: [departmentId], references: [id])
  employeeId      String?
  employee        Employee? @relation(fields: [employeeId], references: [id])
  penaltyType     String
  calculationType CalculationType
  amount          Decimal? @db.Decimal(15,2)
  percentage      Decimal? @db.Decimal(5,2)
  maxDailyAmount  Decimal? @db.Decimal(15,2)
  maxMonthlyAmount Decimal? @db.Decimal(15,2)
  effectiveFrom   DateTime @db.Date
  effectiveTo     DateTime? @db.Date
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  transactions    PenaltyTransaction[]

  @@index([locationId])
  @@index([departmentId])
  @@index([employeeId])
}

model PenaltyTransaction {
  id              String        @id @default(cuid())
  employeeId      String
  employee        Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  penaltyRuleId   String
  penaltyRule     PenaltyRule   @relation(fields: [penaltyRuleId], references: [id], onDelete: Cascade)
  transactionDate DateTime      @db.Date
  calculationBasis String
  calculatedAmount Decimal       @db.Decimal(15,2)
  calculationDetails Json
  status          String        @default("PENDING")
  approvedById    String?
  approvedBy      User?         @relation(fields: [approvedById], references: [id])
  approvedAt      DateTime?
  payrollRunId    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([employeeId, transactionDate])
  @@index([penaltyRuleId])
  @@index([status])
}

model Attendance {
  id                  String           @id @default(cuid())
  employeeId          String
  employee            Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  locationId          String
  location            Location         @relation(fields: [locationId], references: [id], onDelete: Cascade)
  shiftId             String?
  shift               Shift?           @relation(fields: [shiftId], references: [id])
  attendanceDate      DateTime         @db.Date
  scheduledLogin      DateTime?
  actualLogin         DateTime?
  scheduledLogout     DateTime?
  actualLogout        DateTime?
  earlyLoginSeconds   Int              @default(0)
  lateLoginSeconds    Int              @default(0)
  earlyLogoutSeconds  Int              @default(0)
  overtimeSeconds     Int              @default(0)
  totalWorkingSeconds Int              @default(0)
  breakSeconds        Int              @default(0)
  effectiveWorkingSeconds Int          @default(0)
  earlyLoginIncentive Decimal          @default(0) @db.Decimal(15,2)
  lateLoginPenalty    Decimal          @default(0) @db.Decimal(15,2)
  overtimeIncentive   Decimal          @default(0) @db.Decimal(15,2)
  earlyLogoutPenalty  Decimal          @default(0) @db.Decimal(15,2)
  status              AttendanceStatus @default(ABSENT)
  faceVerified        Boolean          @default(false)
  faceMatchPercentage Decimal?         @db.Decimal(5,2)
  notes               String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@unique([employeeId, attendanceDate])
  @@index([locationId, attendanceDate])
  @@index([shiftId])
  @@index([status])
}

model Observation {
  id              String            @id @default(cuid())
  employeeId      String
  employee        Employee          @relation("ObservationEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  locationId      String
  location        Location          @relation(fields: [locationId], references: [id], onDelete: Cascade)
  floorId         String?
  floor           Floor?            @relation(fields: [floorId], references: [id])
  sectionId       String?
  section         Section?          @relation(fields: [sectionId], references: [id])
  sellingPointId  String?
  sellingPoint    SellingPoint?     @relation(fields: [sellingPointId], references: [id])
  observationType ObservationType
  level           ObservationLevel
  score           Int
  description     String
  actionRequired  String?
  assignedToId    String?
  assignedTo      User?             @relation("ObservationAssignedTo", fields: [assignedToId], references: [id])
  createdById     String
  createdBy       User              @relation("ObservationCreatedBy", fields: [createdById], references: [id])
  dueDate         DateTime?
  status          ObservationStatus @default(OPEN)
  videoUrl        String?
  photoUrl        String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  reactions       ObservationReaction[]
  comments        ObservationComment[]
  attachments     ObservationAttachment[]

  streamObservations         StreamObservation[]
  videoNotes                 VideoNote[]
  @@index([employeeId])
  @@index([locationId])
  @@index([status])
  @@index([createdAt])
}

model ObservationReaction {
  id              String       @id @default(cuid())
  observationId   String
  observation     Observation  @relation(fields: [observationId], references: [id], onDelete: Cascade)
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  reactionType    ReactionType
  createdAt       DateTime     @default(now())

  @@unique([observationId, userId, reactionType])
  @@index([observationId])
  @@index([userId])
}

model ObservationComment {
  id              String   @id @default(cuid())
  observationId   String
  observation     Observation @relation(fields: [observationId], references: [id], onDelete: Cascade)
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentId        String?
  parent          ObservationComment? @relation("CommentReplies", fields: [parentId], references: [id])
  replies         ObservationComment[] @relation("CommentReplies")
  content         String
  mentions        Json?
  attachments     Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([observationId])
  @@index([userId])
  @@index([parentId])
}

model ObservationAttachment {
  id              String   @id @default(cuid())
  observationId   String
  observation     Observation @relation(fields: [observationId], references: [id], onDelete: Cascade)
  fileName        String
  fileUrl         String
  fileType        String
  fileSize        Int
  uploadedById    String
  uploadedBy      User     @relation(fields: [uploadedById], references: [id])
  createdAt       DateTime @default(now())

  @@index([observationId])
}

model LiveStream {
  id            String            @id @default(cuid())
  title         String
  description   String?
  locationId    String
  location      Location          @relation(fields: [locationId], references: [id], onDelete: Cascade)
  floorId       String?
  floor         Floor?            @relation(fields: [floorId], references: [id])
  sectionId     String?
  section       Section?          @relation(fields: [sectionId], references: [id])
  sellingPointId String?
  sellingPoint  SellingPoint?     @relation(fields: [sellingPointId], references: [id])
  hostId        String
  host          User              @relation("LiveStreamHost", fields: [hostId], references: [id])
  streamUrl     String
  streamKey     String            @unique
  status        LiveStreamStatus  @default(SCHEDULED)
  viewerCount   Int               @default(0)
  startedAt     DateTime?
  endedAt       DateTime?
  scheduledAt   DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  viewers       LiveStreamViewer[]
  messages      LiveStreamMessage[]
  reactions     LiveStreamReaction[]
  observations  StreamObservation[]
  timestamps    StreamTimestamp[]

  @@index([locationId])
  @@index([status])
  @@index([hostId])
}

model LiveStreamViewer {
  id          String     @id @default(cuid())
  streamId    String
  stream      LiveStream @relation(fields: [streamId], references: [id], onDelete: Cascade)
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt    DateTime   @default(now())
  leftAt      DateTime?
  isActive    Boolean    @default(true)

  @@unique([streamId, userId])
  @@index([streamId])
  @@index([userId])
}

model LiveStreamMessage {
  id          String   @id @default(cuid())
  streamId    String
  stream      LiveStream @relation(fields: [streamId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content     String
  createdAt   DateTime @default(now())

  @@index([streamId])
  @@index([userId])
}

model LiveStreamReaction {
  id          String   @id @default(cuid())
  streamId    String
  stream      LiveStream @relation(fields: [streamId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reactionType String
  createdAt   DateTime @default(now())

  @@index([streamId])
  @@index([userId])
}

model StreamObservation {
  id              String     @id @default(cuid())
  streamId        String
  stream          LiveStream @relation(fields: [streamId], references: [id], onDelete: Cascade)
  observationId   String
  observation     Observation @relation(fields: [observationId], references: [id], onDelete: Cascade)
  timestampSeconds Int
  createdById     String
  createdBy       User       @relation(fields: [createdById], references: [id])
  createdAt       DateTime   @default(now())

  @@index([streamId])
  @@index([observationId])
}

model StreamTimestamp {
  id              String   @id @default(cuid())
  streamId        String
  stream          LiveStream @relation(fields: [streamId], references: [id], onDelete: Cascade)
  timestampSeconds Int
  label           String
  notes           String?
  createdById     String
  createdBy       User     @relation(fields: [createdById], references: [id])
  createdAt       DateTime @default(now())

  @@index([streamId])
}

model AuditLog {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  locationId  String?
  location    Location?   @relation(fields: [locationId], references: [id])
  action      AuditAction
  entityType  String
  entityId    String
  oldValue    Json?
  newValue    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime    @default(now())

  @@index([userId])
  @@index([locationId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model VideoNote {
  id            String   @id @default(cuid())
  observationId String?
  observation   Observation? @relation(fields: [observationId], references: [id])
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  locationId    String
  location      Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  sellingPointId String?
  sellingPoint  SellingPoint? @relation(fields: [sellingPointId], references: [id])
  title         String
  description   String?
  videoUrl      String
  thumbnailUrl  String?
  duration      Int?
  recordedAt    DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([employeeId])
  @@index([locationId])
  @@index([observationId])
}

model PayrollRun {
  id          String   @id @default(cuid())
  periodStart DateTime @db.Date
  periodEnd   DateTime @db.Date
  status      String   @default("DRAFT")
  processedBy String?
  processedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items       PayrollItem[]
}

model PayrollItem {
  id              String   @id @default(cuid())
  payrollRunId    String
  payrollRun      PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  basicSalary     Decimal  @db.Decimal(15,2)
  earlyIncentive  Decimal  @default(0) @db.Decimal(15,2)
  attendanceIncentive Decimal @default(0) @db.Decimal(15,2)
  performanceIncentive Decimal @default(0) @db.Decimal(15,2)
  salesIncentive  Decimal  @default(0) @db.Decimal(15,2)
  overtime        Decimal  @default(0) @db.Decimal(15,2)
  deductions      Decimal  @default(0) @db.Decimal(15,2)
  penalties       Decimal  @default(0) @db.Decimal(15,2)
  netPay          Decimal  @db.Decimal(15,2)
  calculationDetails Json
  status          String   @default("PENDING")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([payrollRunId])
  @@index([employeeId])
}
