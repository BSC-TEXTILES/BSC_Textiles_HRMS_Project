# Backend API URL (browser + server side)
NEXT_PUBLIC_API_URL="http://localhost:4000/api"

# Server-side fallback used by `lib/auth.ts` (NextAuth authorize callback)
API_URL="http://localhost:4000/api"

# NextAuth — MUST be at least 32 characters.
# Generate with:  openssl rand -base64 48
NEXTAUTH_SECRET="bsc-textiles-hrms-super-secret-jwt-key-2024-production-ready-32chars"
NEXTAUTH_URL="http://localhost:3000"

# Optional: override the backend origin used by the /api rewrite fallback
BACKEND_URL="http://localhost:4000"
