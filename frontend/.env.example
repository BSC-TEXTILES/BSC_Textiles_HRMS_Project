# Backend API URL (browser + server side)
NEXT_PUBLIC_API_URL="http://localhost:4000/api"

# Server-side fallback used by `lib/auth.ts` (NextAuth authorize callback)
API_URL="http://localhost:4000/api"

# NextAuth — MUST be at least 32 characters.
# Generate with:  openssl rand -base64 48
NEXTAUTH_SECRET="your-strong-random-nextauth-secret-min-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# Optional: override the backend origin used by the /api rewrite fallback
BACKEND_URL="http://localhost:4000"

# ===========================================================================
# Hardware Biometric IoT Terminals (eSSL & ZKTeco Standalone Attendance Clocks)
# Protocol: TCP/IP Port 4370 (ZKTeco standalone SDK / Push)
# Authoritative storage: Cloud MySQL (bsc_textiles_hrms)
# ===========================================================================
BIOMETRIC_TERMINAL_PORT=4370

