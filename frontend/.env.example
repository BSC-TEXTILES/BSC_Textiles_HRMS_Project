# =============================================================================
# BSC Textiles HRMS — Frontend Environment Template (.env.example)
# =============================================================================

NODE_ENV="production"

# Relative URL so Next.js rewrites proxy to backend (same-origin for HttpOnly cookies)
NEXT_PUBLIC_API_URL="/api"

# NextAuth — Minimum 32 characters (generate with: openssl rand -base64 48)
NEXTAUTH_SECRET="your-strong-random-nextauth-secret-min-32-chars"
NEXTAUTH_URL="https://hrms.bsctextiles.in"

# Backend Origin URL for server-side operations and Next.js rewrites
BACKEND_URL="http://127.0.0.1:4000"
API_URL="http://127.0.0.1:4000/api"

# WebSocket URL for real-time features (optional)
NEXT_PUBLIC_WS_URL=""
