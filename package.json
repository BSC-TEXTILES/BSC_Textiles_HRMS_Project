{
  "name": "bsc-textiles-hrms",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "database",
    "desktop"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:desktop": "concurrently -k \"npm run dev:backend\" \"npm run dev:frontend\" \"wait-on http://127.0.0.1:3000 http://127.0.0.1:4000/api/health && electron desktop/dist/main.js\"",
    "build": "npm run build --workspaces",
    "build:backend": "npm run build --workspace=backend",
    "build:frontend": "npm run build --workspace=frontend",
    "build:desktop": "npm run build --workspace=desktop",
    "package:win": "electron-builder --project desktop",
    "db:migrate": "npm run db:migrate --workspace=database",
    "db:seed": "npm run db:seed --workspace=database",
    "db:setup": "npm run db:setup --workspace=database",
    "db:schema": "npm run db:schema --workspace=database",
    "db:migrate-to-sqlite": "tsx scripts/migrateToSqlite.ts",
    "icons:generate": "tsx scripts/generateDesktopIcons.ts",
    "install:all": "npm install",
    "test": "npm test --workspace=backend",
    "benchmark": "npm run benchmark --workspace=backend",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "mobile:start": "npm start --prefix mobile",
    "mobile:typecheck": "npm run typecheck --prefix mobile"
  },
  "devDependencies": {
    "concurrently": "^9.2.5",
    "electron": "^44.7.0",
    "electron-builder": "^26.17.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "wait-on": "^9.5.1"
  },
  "overrides": {
    "@electron/get": "^5.1.0",
    "builder-util-runtime": "^9.7.0",
    "next": "15.5.27",
    "eslint-config-next": "15.5.27",
    "next-auth": {
      ".": "4.24.15",
      "nodemailer": "^10.1.0",
      "uuid": "^11.1.1"
    },
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "postcss": "^8.5.29",
    "postcss-selector-parser": "^7.1.6",
    "glob": "^10.5.0",
    "dompurify": "^3.4.16",
    "braces": "npm:@xiaoxige1/braces@^3.2.2",
    "nodemailer": "^10.1.0",
    "@xmldom/xmldom": "^0.9.12",
    "fast-xml-parser": "^5.11.2",
    "image-size": "^2.0.4",
    "ip": "^2.0.1",
    "node-forge": "npm:@andreeewill/node-forge@^2.0.0",
    "semver": "^7.8.5",
    "send": "0.19.0",
    "sprintf-js": "^1.1.3",
    "argparse": "^2.0.1",
    "tar": "^7.5.22",
    "uuid": "^11.1.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
