{
  "name": "bsc-textiles-hrms",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "database"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:app": "concurrently -k -n api,web -c blue,green \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:all": "concurrently -k -n api,web,device -c blue,green,magenta \"npm run dev:backend\" \"npm run dev:frontend\" \"npm run worker:supervised\"",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build": "npm run build --workspaces",
    "build:backend": "npm run build --workspace=backend",
    "build:frontend": "npm run build --workspace=frontend",
    "db:migrate": "npm run db:migrate --workspace=database",
    "db:seed": "npm run db:seed --workspace=database",
    "db:setup": "npm run db:setup --workspace=database",
    "db:schema": "npm run db:schema --workspace=database",
    "install:all": "npm install",
    "test": "npm test --workspace=backend",
    "benchmark": "npm run benchmark --workspace=backend",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "db:seed:biometric-demo": "npm run db:seed:biometric-demo --workspace=database",
    "test:biometric": "npm run test:biometric --workspace=backend",
    "worker": "npm run worker --workspace=backend",
    "worker:supervised": "npm run worker:supervised --workspace=backend",
    "device:simulator": "npm run device:simulator --workspace=backend",
    "diagnose": "npm run diagnose --workspace=backend",
    "setup:local": "npm run db:schema --workspace=database && npm run db:migrate --workspace=database && npm run db:seed --workspace=database && npm run db:seed:biometric-demo --workspace=database",
    "connector": "tsx connector/bscBiometricConnector.ts",
    "db:seed:rbac-demo": "npm run db:seed:rbac-demo --workspace=database",
    "test:rbac": "npm run test:rbac --workspace=backend",
    "test:security": "npm run test:security --workspace=backend",
    "test:live": "npm run test:live --workspace=backend",
    "secret-scan": "node scripts/scan-secrets.mjs",
    "test:export": "npm run test:export --workspace=backend"
  },
  "devDependencies": {
    "concurrently": "^9.2.5",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "overrides": {
    "next": "15.5.27",
    "eslint-config-next": "15.5.27",
    "next-auth": {
      ".": "4.24.15",
      "nodemailer": "^10.1.0",
      "uuid": "^11.1.1"
    },
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "postcss": "^8.5.29",
    "postcss-selector-parser": "^7.1.6",
    "glob": "^10.5.0",
    "dompurify": "^3.4.16",
    "braces": "3.0.3",
    "nodemailer": "^10.1.0",
    "@xmldom/xmldom": "^0.9.12",
    "fast-xml-parser": "^5.11.2",
    "image-size": "^2.0.4",
    "ip": "^2.0.1",
    "node-forge": "^1.3.1",
    "semver": "^7.8.5",
    "send": "0.19.0",
    "sprintf-js": "^1.1.3",
    "argparse": "^2.0.1",
    "tar": "^7.5.22",
    "uuid": "^11.1.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
